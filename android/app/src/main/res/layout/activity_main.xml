<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SEVBY"
                android:textColor="@color/accent"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/engineCheck"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engine" />
        </LinearLayout>

        <TextView
            android:id="@+id/engineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starting engine…"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/updateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/updateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/updateNow"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update" />
        </LinearLayout>

        <!-- Songs -->
        <TextView
            style="@style/SectionTitle"
            android:text="Songs (one “Artist - Title” per line)" />

        <EditText
            android:id="@+id/songs"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="6dp"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="Perturbator - Future Club\nCarpenter Brut - Turbo Killer"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/loadTxt"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Load .txt" />

            <Button
                android:id="@+id/clearSongs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Clear" />

            <TextView
                android:id="@+id/songCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- Folder -->
        <TextView
            style="@style/SectionTitle"
            android:text="Save to" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/folderName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/chooseFolder"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose" />
        </LinearLayout>

        <!-- Source -->
        <TextView
            style="@style/SectionTitle"
            android:text="Source" />

        <RadioGroup
            android:id="@+id/sourceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/srcBoth"
                style="@style/SourceChoice"
                android:text="Bandcamp + YouTube" />

            <TextView
                style="@style/SourceNote"
                android:text="Bandcamp first, YouTube for anything Bandcamp doesn't have" />

            <RadioButton
                android:id="@+id/srcBandcamp"
                style="@style/SourceChoice"
                android:text="Bandcamp only" />

            <TextView
                style="@style/SourceNote"
                android:text="Songs that aren't on Bandcamp are skipped" />

            <RadioButton
                android:id="@+id/srcYoutube"
                style="@style/SourceChoice"
                android:text="YouTube only" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/start"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Start"
                android:textSize="16sp" />

            <Button
                android:id="@+id/pause"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:minWidth="110dp"
                android:text="Pause"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Progress (shown while running) -->
        <LinearLayout
            android:id="@+id/progressBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="1000"
                app:indicatorTrackGapSize="0dp"
                app:trackStopIndicatorSize="0dp" />
        </LinearLayout>

        <!-- Log -->
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:minHeight="120dp"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
